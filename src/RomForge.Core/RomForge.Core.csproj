<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Authors>Ben de Bruijn</Authors>
    <Copyright>Copyright © 2026 Ben de Bruijn</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).IntegrationTests" />
    <InternalsVisibleTo Include="RomForge.UI.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuraIT.SevenZipSharper" Version="2.0.0" />
    <PackageReference Include="DuraIT.SevenZipSharper.Native" Version="2.0.0" />
    <PackageReference Include="FluentResults" Version="4.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <!-- Microsoft.Data.Sqlite floors this at the vulnerable 2.1.11 (GHSA-2m69-gcr7-jv3q); pin newer. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.30.0.144632">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
